{
  "name": "open-source-metrics-so",
  "version": "1.0.0",
  "description": "A high-performance Node.js/TypeScript library to measure developer activity, contribution velocity, code frequency, and issue resolution metrics using GitHub GraphQL and REST APIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"README.md\""
  },
  "keywords": [
    "github",
    "metrics",
    "developer-activity",
    "analytics",
    "typescript",
    "graphql",
    "rest-api",
    "velocity"
  ],
  "author": "Somali Open Source Community",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "node-cache": "^5.1.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
